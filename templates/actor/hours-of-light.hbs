<div class="light-hours-row">
    <div class="label">{{localize 'FO.HoursOfLight'}}</div>
    <ul class="light-bullets">
        {{#times 13}}
        <li>
            <label>
                <input 
                    class="{{#ifLt this ../data.system.hoursOfLight}}light{{/ifLt}} {{#ifGt this ../data.system.hoursOfLight}}dark{{/ifGt}}"
                    type="radio" 
                    name="system.hoursOfLight" 
                    value="{{this}}"
                    data-dtype="Number" 
                    {{#ifEq this ../data.system.hoursOfLight}}checked{{/ifEq}}/>
                <span>{{this}}</span>
            </label>
        </li>
        {{/times}}
    </ul>              
</div>

