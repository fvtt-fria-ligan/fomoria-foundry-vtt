<div class="tab violence-tab" data-group="primary" data-tab="violence">
  <div class="initiative-row">
    <div class="sheet-label">{{ localize 'FO.RollInitiative' }}:</div>
    <button type="button" class="sheet-button medium-button party-initiative-button">{{ localize 'FO.Cabal' }} <i class="fas fa-dice-six fa-fw"></i></button>
    <button type="button" class="sheet-button medium-button individual-initiative-button">{{ localize 'FO.Individual' }} <i class="fas fa-dice-six fa-fw"></i></button>
  </div>

  <div class="violence-grid cols">
    <div class="col">
      {{#if data.system.equippedMainHand}}
        <div class="main-hand-cell">
          <div class="col-title">
            {{#if data.system.equippedMainHand.system.twoHanded}}
              {{localize 'FO.TwoHanded'}}
            {{else}}
              {{localize 'FO.MainHand'}}
            {{/if}}
          </div>
          <div class="item-list weapons">
            <div class="item item-row weapon-row" data-item-id="{{data.system.equippedMainHand._id}}">
              <div class="bullet">g</div>
              <div class="item-fields">
                <div class="item-field-row item-name-row">        
                  <div class="item-name"><a class="item-control item-edit">{{data.system.equippedMainHand.name}}</a>
                      &nbsp;({{data.system.equippedMainHand.system.damage}})
                  </div>
                  <div class="item-controls">
                    <button type="button" class="sheet-button attack-button">{{localize 'FO.Attack'}} <i class="fas fa-dice-d20 fa-fw"></i></button>                    
                    <a class="item-control item-equip-main-hand equipped" title="{{localize 'FO.ToggleMainHand'}}"><i class="fas fa-hand"></i></a>
                    <a class="item-control item-edit" title="{{localize 'FO.Edit'}}"><i class="fas fa-edit"></i></a>
                    <a class="item-control item-delete" title="{{localize 'FO.Delete'}}"><i class="fas fa-trash"></i></a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      {{/if}}      

      {{#if data.system.equippedOffHand}}
        <div class="off-hand-cell">
          <div class="col-title">{{localize 'FO.OffHand'}}</div>
          <div class="item-list weapons">
            <div class="item item-row weapon-row" data-item-id="{{data.system.equippedOffHand._id}}">
              <div class="bullet">g</div>
              <div class="item-fields">
                <div class="item-field-row item-name-row">        
                  <div class="item-name"><a class="item-control item-edit">{{data.system.equippedOffHand.name}}
                    {{#if data.system.equippedOffHand.system.damage}}
                    &nbsp;({{data.system.equippedOffHand.system.damage}})
                    {{/if}}
                  </a></div>
                  <div class="item-controls">
                    <a class="item-control item-equip-off-hand equipped" title="{{localize 'FO.ToggleOffHand'}}"><i class="fas fa-shield"></i></a>
                    <a class="item-control item-edit" title="{{localize 'FO.Edit'}}"><i class="fas fa-edit"></i></a>
                    <a class="item-control item-delete" title="{{localize 'FO.Delete'}}"><i class="fas fa-trash"></i></a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      {{/if}}

      {{#if data.system.equippedArmor}}
        <div class="armor-cell">
          <div class="col-title">{{localize 'FO.Armor'}}</div>
          <div class="item-list armor">
            <div class="item item-row armor-row" data-item-id="{{data.system.equippedArmor._id}}">
              <div class="bullet">g</div>
              <div class="item-fields">
                <div class="item-field-row item-name-row">        
                  <div class="item-name"><a class="item-control item-edit">{{data.system.equippedArmor.name}}</a></div>
                  <div class="item-controls">
                    <a class="item-control item-equip-armor equipped" title="{{localize 'FO.ToggleArmor'}}"><i class="fas fa-shirt"></i></a>
                    <a class="item-control item-edit" title="{{localize 'FO.Edit'}}"><i class="fas fa-edit"></i></a>
                    <a class="item-control item-delete" title="{{localize 'FO.Delete'}}"><i class="fas fa-trash"></i></a>
                  </div>
                </div>           
                <div class="item-field-row">
                  <label class="tier-label">{{ localize 'FO.Tier' }}</label>
                  <ul class="tiers">
                    <li>
                      <label
                        ><input class="tier-radio" type="radio"
                        name="{{data.system.equippedArmor._id}}.tier.value" value="0" {{#ifEq
                        data.system.equippedArmor.system.tier.value
                        0}}checked{{/ifEq}}/><span class="tier-num">0</span
                        ><span class="tier-dmg">-0</span></label
                      >
                    </li>
                    <li>
                      <label
                        ><input class="tier-radio" type="radio"
                        name="{{data.system.equippedArmor._id}}.tier.value" value="1" {{#ifEq
                        data.system.equippedArmor.system.tier.value
                        1}}checked{{/ifEq}}/><span class="tier-num">1</span
                        ><span class="tier-dmg">-d2</span></label
                      >
                    </li>
                    <li>
                      <label
                        ><input class="tier-radio" type="radio"
                        name="{{data.system.equippedArmor._id}}.tier.value" value="2" {{#ifEq
                        data.system.equippedArmor.system.tier.value
                        2}}checked{{/ifEq}} {{#ifLt
                        data.system.equippedArmor.system.tier.max
                        2}}disabled="true"{{/ifLt}}/><span class="tier-num"
                          >2</span
                        ><span class="tier-dmg">-d4</span></label
                      >
                    </li>
                    <li>
                      <label
                        ><input class="tier-radio" type="radio"
                        name="{{data.system.equippedArmor._id}}.tier.value" value="3" {{#ifEq
                        data.system.equippedArmor.system.tier.value
                        3}}checked{{/ifEq}} {{#ifLt
                        data.system.equippedArmor.system.tier.max
                        3}}disabled="true"{{/ifLt}}/><span class="tier-num"
                          >3</span
                        ><span class="tier-dmg">-d6</span></label
                      >
                    </li>              
                  </ul>
                </div>
              </div>
            </div>      
          </div>
        </div>
      {{/if}}

      <div class="defend-button-row">
        <button type="button" class="sheet-button medium-button defend-button">{{ localize 'FO.Defend' }} <i class="fas fa-dice-d20 fa-fw"></i></button>
      </div>
    </div>

    <div class="col">
      <div class="expertise-cell">
        <div class="col-title">
          {{localize 'FO.Expertise'}}
          <a class="item-control item-create" data-item-type="expertise" title='{{localize "FO.CreateNewFeat"}}'>
              <i class="fas fa-plus"></i>
          </a>
        </div>
        <div class="item-list weapons">
          {{#each data.system.expertise as |item id|}}
            <div class="item item-row weapon-row" data-item-id="{{item._id}}">
              <div class="bullet">g</div>
              <div class="item-fields">
                <div class="item-field-row item-name-row">        
                  <div class="item-name">
                    <a class="item-control item-edit">{{item.name}}</a> ({{item.system.level}})
                  </div>
                  <div class="item-controls">
                    <a class="item-control item-edit" title="{{localize 'FO.Edit'}}"><i class="fas fa-edit"></i></a>
                    <a class="item-control item-delete" title="{{localize 'FO.Delete'}}"><i class="fas fa-trash"></i></a>
                  </div>
                </div>          
              </div>
            </div>
          {{/each}}      
        </div>
      </div>

      <div class="weaponfeats-cell">
        <div class="col-title">
          {{localize 'FO.WeaponFeats'}}
          <a class="item-control item-create" data-item-type="weaponfeat" title='{{localize "FO.CreateNewFeat"}}'>
              <i class="fas fa-plus"></i>
          </a>
        </div>
        <div class="item-list weaponfeats">
          {{#each data.system.weaponfeats as |item id|}}
            <div class="item item-row weapon-feat-row" data-item-id="{{item._id}}">
              <div class="bullet">g</div>
              <div class="item-fields">
                <div class="item-field-row item-name-row">        
                  <div class="item-name">
                    <a class="item-control item-edit">{{item.name}}</a>
                  </div>
                  <div class="item-controls">
                    <a class="item-control item-edit" title="{{localize 'FO.Edit'}}"><i class="fas fa-edit"></i></a>
                    <a class="item-control item-delete" title="{{localize 'FO.Delete'}}"><i class="fas fa-trash"></i></a>
                  </div>
                </div>          
              </div>
            </div>
          {{/each}}      
        </div>
      </div>      
    </div>

  </div>
</div>
