{{#*inline "itemPartial"}}
<div class="item item-row equipment-row" data-item-id="{{item._id}}">
  <div class="bullet">g</div>
  <div class="item-fields">
    <div class="item-field-row item-name-row">        
      <div class="item-name">
        <a class="item-control item-edit" title="{{localize 'FO.Edit'}}">{{item.name}}</a>
        {{#if item.system.usesQuantity}}    
          &nbsp;
          ( {{item.system.quantity}} )
          &nbsp;
          <a class="item-control item-qty-minus" title="Subtract Quantity"><i class="fas fa-minus"></i></a>
          <a class="item-control item-qty-plus" title="Add Quantity"><i class="fas fa-plus"></i></a>
        {{/if}}
      </div>
      <div class="item-controls">
        {{#if item.system.equippableMainHand}}
          <a class="item-control item-equip-main-hand {{item.system.equippedMainHandClass}}" title="{{localize 'FO.ToggleMainHand'}}"><i class="fas fa-hand"></i></a>
        {{/if}}
        {{#if item.system.equippableOffHand}}
          <a class="item-control item-equip-off-hand {{item.system.equippedOffHandClass}}" title="{{localize 'FO.ToggleOffHand'}}"><i class="fas fa-shield"></i></a>
        {{/if}}
        {{#if item.system.equippableArmor}}
          <a class="item-control item-equip-armor {{item.system.equippedArmorClass}}" title="{{localize 'FO.ToggleArmor'}}"><i class="fas fa-shirt"></i></a>
        {{/if}}
        <a class="item-control item-delete" title="{{localize 'FO.Delete'}}"><i class="fas fa-trash"></i></a>
      </div>
    </div>          
  </div>
</div>
{{/inline}}

<div class="tab gear-tab" data-group="primary" data-tab="gear">
  <div class="cols">

    <div class="col">
      <div class="col-title">
        {{localize 'FO.Gear'}}
          <a class="item-control add-gear" data-item-type="condition" title='{{localize "FO.CreateNewFeat"}}'>
              <i class="fas fa-plus"></i>
          </a>
      </div>

      <div class="equipment item-list">
        {{#each data.system.equipment as |item id|}}
          {{> itemPartial item=item}}
        {{/each}}
      </div>
    </div>

    <div class="col">
      <div class="gear-row">
        <div class="carrying {{data.system.encumberedClass}}">
          <div class="sheet-label gear-label">
            {{ localize 'FO.Carrying'}}: 
          </div>
          <div class="gear-value carrying-value">
            {{ceil actor.carryingSlots}} / {{actor.carryingCapacity}}
          </div>
        </div>
      </div>
      <div class="gear-row">
        <div class="silver">
          <div class="sheet-label gear-label">
            {{ localize 'FO.Silver'}}: 
          </div>
          <div class="gear-value silver-value">
            <input type="number" name="system.silver" value="{{data.system.silver}}" />
          </div>
        </div>
      </div>
    </div>
  </div>  

</div>