<div class="abilities-wrapper">
  <div class="ability-row">
    <div class="ability-label">
      <a class="ability-link" data-ability="strength" title="{{ localize 'FO.Strength' }}">
        <div class="ability-label">{{ localize 'FO.StrengthAbbrev' }}</div>
      </a>
    </div>
    <div class="ability-score">
      <input class="strength" type="number" name="system.abilities.strength.value" value="{{data.system.abilities.strength.value}}" />
      <div class="ability-modifier">
        {{#ifNe data.system.abilities.strength.value data.system.abilities.strength.modified}} 
          {{data.system.abilities.strength.modified}}*    
        {{/ifNe}}
      </div>
    </div>
  </div>        
