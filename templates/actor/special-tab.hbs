<div class="tab special-tab" data-group="primary" data-tab="special">
    <div class="cols">

        <div class="col">
            <div class="col-title">
                {{localize 'FO.Feats'}}
                <a class="item-control item-create" data-item-type="feat" title='{{localize "FO.CreateNewFeat"}}'>
                    <i class="fas fa-plus"></i>
                </a>
            </div>
            <div class="feats item-list">
                {{#each data.system.feats as |item id|}}
                <div class="item item-row feat-row" data-item-id="{{item._id}}">
                    <div class="bullet">g</div>
                    <div class="item-fields">
                    <div class="item-field-row item-name-row">
                        <div class="item-name"><a class="item-control item-edit">{{item.name}}</a></div>
                        <div class="item-controls">
                            <a class="item-control item-edit" title="{{localize 'FO.Edit'}}"><i class="fas fa-edit"></i></a>
                            <a class="item-control item-delete" title="{{localize 'FO.Delete'}}"><i class="fas fa-trash"></i></a>
                        </div>
                    </div>
                    </div>
                </div>
                {{else}}
                <div class="no-feats">
                    {{localize 'FO.YouHaveNoFeats'}}
                </div>
                {{/each}}    
            </div>            
        </div>

        <div class="col">
            <div class="col-title">
                {{localize 'FO.Boons'}}  
                <a class="item-control item-create" data-item-type="boon" title='{{localize "FO.CreateNewFeat"}}'>
                    <i class="fas fa-plus"></i>
                </a>
            </div>
            <div class="boons item-list">
                {{#each data.system.boons as |item id|}}
                <div class="item item-row boon-row" data-item-id="{{item._id}}">
                    <div class="bullet">g</div>
                    <div class="item-fields">
                    <div class="item-field-row item-name-row">
                        <div class="item-name"><a class="item-control item-edit">{{item.name}}</a></div>
                        <div class="item-controls">
                            <a class="item-control item-edit" title="{{localize 'FO.Edit'}}"><i class="fas fa-edit"></i></a>
                            <a class="item-control item-delete" title="{{localize 'FO.Delete'}}"><i class="fas fa-trash"></i></a>
                        </div>
                    </div>
                    </div>
                </div>
                {{else}}
                <div class="no-boons">
                    {{localize 'FO.YouHaveNoBoons'}}
                </div>
                {{/each}}    
            </div>            
        </div>

        <div class="col">
            <div class="col-title">
              {{localize 'FO.Conditions'}}
                <a class="item-control item-create" data-item-type="condition" title='{{localize "FO.CreateNewFeat"}}'>
                    <i class="fas fa-plus"></i>
                </a>
            </div>
            <div class="conditions item-list">
                {{#each data.system.conditions as |item id|}}
                <div class="item item-row feat-row" data-item-id="{{item._id}}">
                    <div class="bullet">g</div>
                    <div class="item-fields">
                    <div class="item-field-row item-name-row">
                        <div class="item-name"><a class="item-control item-edit">{{item.name}}</a></div>
                        <div class="item-controls">
                            <a class="item-control item-edit" title="{{localize 'FO.Edit'}}"><i class="fas fa-edit"></i></a>
                            <a class="item-control item-delete" title="{{localize 'FO.Delete'}}"><i class="fas fa-trash"></i></a>
                        </div>
                    </div>
                    </div>
                </div>
                {{else}}
                <div class="no-conditions">
                    {{localize 'FO.YouHaveNoConditions'}}
                </div>
                {{/each}}    
            </div>            
        </div>

    </div>
</div>
