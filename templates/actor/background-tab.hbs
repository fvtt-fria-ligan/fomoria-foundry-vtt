<div class="tab background-tab" data-group="primary" data-tab="background">
  <div class="folk-row">
    <div class="linked-item-widget">
      <div class="sheet-label linked-item-label">
        {{localize 'FO.Folk'}}:
      </div>
      <div class="linked-item-value">
        <div class="item" data-item-id="{{data.system.folk._id}}">
          <div class="linked-item-name"><a class="item-control item-edit">{{data.system.folk.name}}</a></div>
        </div>
      </div>
    </div>
    <div class="linked-item-widget">
      <div class="sheet-label linked-item-label">
        {{localize 'FO.Clan'}}:
      </div>
      <div class="linked-item-value">
        <div class="item" data-item-id="{{data.system.clan._id}}">
          <div class="linked-item-name"><a class="item-control item-edit">{{data.system.clan.name}}</a></div>
        </div>
      </div>
    </div>              
    <div class="linked-item-widget">
      <div class="sheet-label linked-item-label">
        {{localize 'FO.Tradition'}}:
      </div>
      <div class="linked-item-value">
        <div class="item" data-item-id="{{data.system.tradition._id}}">
          <div class="linked-item-name"><a class="item-control item-edit">{{data.system.tradition.name}}</a></div>
        </div>
      </div>
    </div>            

  </div>
  {{editor data.system.description target="system.description"
  button=true owner=owner editable=true engine="prosemirror"}}        
</div>
